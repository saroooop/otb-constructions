# Copy to .env.local for development, and set the same keys in the Vercel
# project (Settings → Environment Variables). Everything here is optional:
# with nothing set, the contact form still works and logs the enquiry.

# ── Supabase — the durable record of every enquiry ──────────
# Project Settings → API. The service role key bypasses RLS, so it is SERVER
# ONLY: never prefix it with NEXT_PUBLIC_ and never import it into a client
# component. The anon key is not needed — this site has no browser-side reads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend — the notification email ─────────────────────────
# CONTACT_FROM must be on a domain verified in Resend, or sends are rejected.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# ── Privacy ─────────────────────────────────────────────────
# Any long random string. Client IPs are stored as SHA-256(salt + ip), never
# raw. Leave this empty and no IP data is stored at all, which is also fine.
IP_HASH_SALT=
